  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build:ios": "node scripts/build.mjs ios",
    "build:preview": "npm run build:web",
    "build:ios:simulator": "npm run build:ios && node scripts/ios-simulator.mjs",
    "test:ios": "node scripts/test-ios.mjs",
    "build:ios:device": "npm run build:ios && node scripts/ios-device.mjs",
    "test:paper": "node scripts/test-paper.mjs",
    "bench:paper": "node scripts/test-paper.mjs --bench",
    "build:web": "node scripts/build-paper-web.mjs && node scripts/build.mjs web-mobile && node scripts/package-web.mjs",
    "preview:web": "node scripts/serve-web.mjs",
    "test:web-kernel": "node scripts/test-paper-web.mjs",
    "test:web-bundle": "node scripts/test-web-bundle.mjs"
  },
  "devDependencies": {
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
